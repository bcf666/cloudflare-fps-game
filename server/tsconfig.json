{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["./shared/*"]
    },
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/**/*.ts",
    "../shared/**/*.ts"
  ]
}
